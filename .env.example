# Copy to .env for local development. Never commit .env.

# Local PostgreSQL (compose.dev.yaml). Development only.
POSTGRES_USER=cafe_loyalty_dev
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_DB=cafe_loyalty_dev
POSTGRES_PORT=5432

# Database roles and connections (packages/db). Development values only; staging and production use their own.
# Superuser connection used by `pnpm db:bootstrap` to create roles and the database (use the POSTGRES_* values above).
DATABASE_ADMIN_URL=postgres://cafe_loyalty_dev:choose-a-local-password@127.0.0.1:5432/postgres
DATABASE_NAME=cafe_loyalty
MIGRATOR_ROLE=cafe_loyalty_migrator
MIGRATOR_PASSWORD=choose-a-local-migrator-password
APP_ROLE=cafe_loyalty_app
APP_PASSWORD=choose-a-local-app-password
# Used by `pnpm db:migrate`: the migrator role on the application database.
MIGRATOR_DATABASE_URL=postgres://cafe_loyalty_migrator:choose-a-local-migrator-password@127.0.0.1:5432/cafe_loyalty
# Used by `pnpm test:db`: superuser connection; each test file creates and drops its own database and roles.
TEST_DATABASE_ADMIN_URL=postgres://cafe_loyalty_dev:choose-a-local-password@127.0.0.1:5432/postgres
# Optional for `pnpm check:migrations`: base branch whose existing migrations must be unchanged (CI sets it on pull requests).
# MIGRATIONS_BASE_REF=origin/main

# API server (apps/server)
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Optional: milliseconds to wait for in-flight requests on shutdown (default 10000).
# SHUTDOWN_TIMEOUT_MS=10000
# The app login role on the application database (APP_ROLE and APP_PASSWORD above). Also used by create-invite.
DATABASE_URL=postgres://cafe_loyalty_app:choose-a-local-app-password@127.0.0.1:5432/cafe_loyalty
# Optional: connection pool size (default 10).
# DATABASE_MAX_CONNECTIONS=10
# Public address of the owner dashboard, used in invite and password reset links (locally, the dashboard dev server).
DASHBOARD_URL=http://localhost:5173
# Public address of the counter app, which pairing QR codes open (locally, the counter dev server). No path.
COUNTER_URL=http://localhost:5174
# Public address of this server's customer pages (café signup QR, web cards, recovery links). No path.
PUBLIC_URL=http://localhost:3000
# Customer data secrets. Generate each key with `openssl rand -base64 32`; never reuse them across environments.
# Pepper for phone and email lookup hashes: never change it once customers exist.
PHONE_LOOKUP_PEPPER=choose-a-32-byte-base64-pepper
# Keyrings: comma-separated id:key entries (ids of lower-case letters or digits), newest first; keep an old key
# listed while data made with it may exist. Phone numbers are encrypted with the first key; QR codes signed with it.
PHONE_ENCRYPTION_KEYS=p1:choose-a-32-byte-base64-key
CARD_QR_KEYS=q1:choose-a-32-byte-base64-key
# Optional outside production: when this release was built (ISO 8601 UTC, the commit time), the same value the
# counter build was made with. Counter builds more than 14 days older get CLIENT_TOO_OLD for new actions. Defaults to
# the server's start time; required in production.
# BUILT_AT=2026-10-09T08:00:00Z
# Reverse proxies in front of the server, so rate limits see client addresses (Caddy: 1). Optional in development
# (default 0); required in production, where DASHBOARD_URL must also be https.
# TRUST_PROXY_HOPS=0
# Outgoing email (owner password resets) through any SMTP provider. SMTP_SECURE=true for implicit TLS (port 465);
# false for port 587, where STARTTLS is then required. SMTP_USER and SMTP_PASSWORD go together; leave both unset only
# for a local mail catcher such as Mailpit (required in production).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=choose-an-smtp-user
SMTP_PASSWORD=choose-an-smtp-password
EMAIL_FROM="Cafe Loyalty <no-reply@example.com>"

# Background worker (apps/worker) reads NODE_ENV, LOG_LEVEL and SHUTDOWN_TIMEOUT_MS from above.

# Optional for the dashboard and counter dev servers: forward /api to a local API server.
# DASHBOARD_API_PROXY=http://127.0.0.1:3000
# COUNTER_API_PROXY=http://127.0.0.1:3000

# Optional build settings for the counter and dashboard apps, read from the build's environment (not from .env):
# BUILD_ID, the build id they display (default "dev"; CI sets it to the commit SHA), and, for the counter, BUILT_AT
# (as above; default: the time of the build), which it sends with every request. The counter build fails on a
# BUILT_AT that is not an ISO 8601 UTC time.
# BUILD_ID=dev

# Optional Playwright settings (defaults shown). CI is set by GitHub Actions and enables CI mode.
# E2E_HOST=127.0.0.1
# E2E_COUNTER_PORT=4173
# E2E_DASHBOARD_PORT=4174
