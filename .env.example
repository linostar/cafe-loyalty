# Copy to .env for local development. Never commit .env.

# Local PostgreSQL (compose.dev.yaml). Development only.
POSTGRES_USER=cafe_loyalty_dev
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_DB=cafe_loyalty_dev
POSTGRES_PORT=5432

# Database roles and connections (packages/db). Development values only; staging and production use their own.
# Superuser connection used by `pnpm db:bootstrap` to create roles and the database (use the POSTGRES_* values above).
DATABASE_ADMIN_URL=postgres://cafe_loyalty_dev:choose-a-local-password@127.0.0.1:5432/postgres
DATABASE_NAME=cafe_loyalty
MIGRATOR_ROLE=cafe_loyalty_migrator
MIGRATOR_PASSWORD=choose-a-local-migrator-password
APP_ROLE=cafe_loyalty_app
APP_PASSWORD=choose-a-local-app-password
# Used by `pnpm db:migrate`: the migrator role on the application database.
MIGRATOR_DATABASE_URL=postgres://cafe_loyalty_migrator:choose-a-local-migrator-password@127.0.0.1:5432/cafe_loyalty
# Used by `pnpm test:db`: superuser connection; each test file creates and drops its own database and roles.
TEST_DATABASE_ADMIN_URL=postgres://cafe_loyalty_dev:choose-a-local-password@127.0.0.1:5432/postgres
# Optional for `pnpm check:migrations`: base branch whose existing migrations must be unchanged (CI sets it on pull requests).
# MIGRATIONS_BASE_REF=origin/main

# API server (apps/server)
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Optional: milliseconds to wait for in-flight requests on shutdown (default 10000).
# SHUTDOWN_TIMEOUT_MS=10000

# Background worker (apps/worker) reads NODE_ENV, LOG_LEVEL and SHUTDOWN_TIMEOUT_MS from above.

# Optional build setting for the counter and dashboard apps: the build id they display (default "dev").
# CI sets it to the commit SHA.
# BUILD_ID=dev

# Optional Playwright settings (defaults shown). CI is set by GitHub Actions and enables CI mode.
# E2E_HOST=127.0.0.1
# E2E_COUNTER_PORT=4173
# E2E_DASHBOARD_PORT=4174
