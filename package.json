{
  "name": "cafe-loyalty",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "test": "pnpm typecheck && pnpm lint && pnpm check:migrations && pnpm test:unit && pnpm test:db && pnpm test:e2e",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm build:packages && eslint . --max-warnings 0",
    "test:unit": "pnpm build:packages && vitest run",
    "test:db": "pnpm build:packages && vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "db:up": "docker compose -f compose.dev.yaml --env-file .env up -d --wait",
    "db:down": "docker compose -f compose.dev.yaml --env-file .env down",
    "db:bootstrap": "pnpm build:packages && pnpm --filter @cafe-loyalty/db bootstrap",
    "db:migrate": "pnpm build:packages && pnpm --filter @cafe-loyalty/db migrate",
    "check:migrations": "pnpm build:packages && pnpm --filter @cafe-loyalty/db check-migrations"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "uqr": "^0.1.3",
    "vitest": "^5.0.3"
  }
}
