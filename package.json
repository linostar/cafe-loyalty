{
  "name": "cafe-loyalty",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @cafe-loyalty/shared build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm build:shared && eslint . --max-warnings 0",
    "test:unit": "pnpm build:shared && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "db:up": "docker compose -f compose.dev.yaml --env-file .env up -d --wait",
    "db:down": "docker compose -f compose.dev.yaml --env-file .env down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
