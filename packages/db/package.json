{
  "name": "@cafe-loyalty/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/test-database.d.ts",
      "import": "./dist/testing/test-database.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bootstrap": "node --env-file-if-exists=../../.env dist/bootstrap-cli.js",
    "migrate": "node --env-file-if-exists=../../.env dist/migrate-cli.js",
    "check-migrations": "node dist/check-migrations-cli.js"
  },
  "dependencies": {
    "@cafe-loyalty/shared": "workspace:*",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
